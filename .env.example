# The build bakes these into dist/js/config.js.
# This is a STATIC site — the bot token ends up in public client JS. Use a
# lead-only bot and rotate via @BotFather if it leaks. For a private setup,
# host on a platform with functions and relay through a server endpoint.
TELEGRAM_BOT_TOKEN=123456789:your-bot-token
TELEGRAM_CHAT_ID=000000000
